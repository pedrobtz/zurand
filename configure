#!/bin/sh
# Writes src/Makevars from src/Makevars.in, choosing the OpenMP flags.
#
# Everywhere but macOS this is R's $(SHLIB_OPENMP_CFLAGS), as before: set
# where R was built with OpenMP, empty (a serial build) where it was not.
#
# On macOS R leaves SHLIB_OPENMP_CFLAGS empty, because Apple's clang has
# OpenMP support but no runtime. R itself ships the matching runtime,
# libomp.dylib in $(R_HOME)/lib, and CRAN's build machines add the headers
# (https://mac.r-project.org/openmp/). So try to compile and link a program
# that needs both _OPENMP and <omp.h>, with -Xclang -fopenmp and -lomp; if
# it builds, use those flags, otherwise fall back to the serial build.
# Same approach as data.table's configure. The values never depend on the
# thread count, so either outcome gives identical results.

: "${R_HOME:=$(R RHOME)}"
if [ -z "${R_HOME}" ]; then
  echo "configure: could not determine R_HOME" >&2
  exit 1
fi

OPENMP_CFLAGS='$(SHLIB_OPENMP_CFLAGS)'
OPENMP_LIBS='$(SHLIB_OPENMP_CFLAGS)'

if [ "$(uname)" = "Darwin" ]; then
  tmp=$(mktemp -d 2>/dev/null || echo "${TMPDIR:-/tmp}/zurand-omp.$$")
  mkdir -p "$tmp"
  cat > "$tmp/omp.c" <<'CEOF'
#ifndef _OPENMP
#error "_OPENMP is not defined"
#endif
#include <omp.h>
int zurand_omp_probe(void) { return omp_get_max_threads(); }
CEOF
  printf "%s" "checking whether OpenMP works with -Xclang -fopenmp -lomp... "
  if (cd "$tmp" && PKG_CFLAGS="-Xclang -fopenmp" PKG_LIBS="-lomp" \
        "${R_HOME}/bin/R" CMD SHLIB omp.c > config.log 2>&1); then
    echo "yes"
    OPENMP_CFLAGS="-Xclang -fopenmp"
    OPENMP_LIBS="-lomp"
  else
    echo "no (building without OpenMP; see https://mac.r-project.org/openmp/)"
  fi
  rm -rf "$tmp"
fi

sed -e "s|@OPENMP_CFLAGS@|${OPENMP_CFLAGS}|" \
    -e "s|@OPENMP_LIBS@|${OPENMP_LIBS}|" \
    src/Makevars.in > src/Makevars
exit 0

Package: zurand
Title: Fast Stateless Random Number Generation
Version: 0.0.0.9000
Authors@R: c(
    person("Pedro", "Baltazar", , "pedrobtz@gmail.com", role = c("aut", "cre", "cph")),
    person("D. E. Shaw Research", role = "cph",
           comment = "Random123 library, src/Random123/"),
    person("NumPy Developers", role = "cph",
           comment = "Ziggurat constant tables, src/numpyzig/"),
